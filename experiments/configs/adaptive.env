# Adaptive Batching Configuration
# Dynamically adjusts batch size based on network conditions

REDIS_ADDRESS=localhost
REDIS_PORT=6379
TRACER_REPORTING_HOST=localhost
TRACER_REPORTING_PORT=6831
REDIS_EXPIRATION_TIME=30
SERVICE_STREAM_KEY=adpp-data

EVENT_GENERATOR_TYPE=OCVEventGenerator
EARLY_FILTERING_PIPELINE_NAME=MockedPipeline
DEFAULT_OI_LIST=car

USE_OCV_TRANSFORMS=True

DEFAULT_CACHED_FRAME_RATE_MULTIPLIER=2.5
DEFAULT_DIFF_THRESHOLD=0.15
DEFAULT_CLS_THRESHOLDS=0.3,0.6
DEFAULT_OBJ_THRESHOLD=0.5

PUBLISHER_ID=publisher1
PUBLISHER_INPUT_SOURCE=/service/data/HS-D-B-1.mp4
PUBLISHER_FPS=30
PUBLISHER_RESOLUTION=1920x1080

LISTEN_EVENT_TYPE_EARLY_FILTERING_UPDATED=EarlyFilteringUpdated
LISTEN_EVENT_TYPE_QUERY_CREATED=QueryCreated
LISTEN_EVENT_TYPE_QUERY_REMOVED=QueryRemoved
PUB_EVENT_TYPE_PUBLISHER_CREATED=PublisherCreated
PUB_EVENT_TYPE_PUBLISHER_REMOVED=PublisherRemoved

LOGGING_LEVEL=INFO
REGISTER_EVAL_DATA=True

# ADAPTIVE BATCHING: Dynamically adjusts batch size
USE_MICRO_BATCHING=False
USE_ADAPTIVE_BATCHING=True
BATCH_TIMEOUT=0.5

# Adaptive batching parameters
ADAPTIVE_MIN_BATCH_SIZE=1
ADAPTIVE_MAX_BATCH_SIZE=10
ADAPTIVE_INITIAL_BATCH_SIZE=3
ADAPTIVE_TARGET_BATCH_TIME_MS=200

# Experiment configuration
COLLECT_EXPERIMENT_METRICS=True
EXPERIMENT_NUM_FRAMES=500
